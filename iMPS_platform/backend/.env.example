MONGO_URI=mongodb://<user>:<password>@<host>:27017/?authSource=admin&directConnection=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email>@gmail.com
SMTP_PASS=<gmail-app-password>
SENDER_EMAIL=<your-email>@gmail.com
FRONTEND_BASE_URL=http://localhost:3001
MQTT_BROKER=<broker-ip>
MQTT_PORT=1883

# JWT signing secret — set a strong random value (>=32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Shared secret ที่ Maximo ต้องแนบมาใน header X-Maximo-Token เวลายิง webhook เปิดใบงาน PM
# (POST /maximo/pm/open และ POST /maximo/pm-workorder) — ต้องตั้งค่า ไม่งั้น endpoint ตอบ 503
MAXIMO_WEBHOOK_SECRET=

# ─── Maximo IESB (EGAT_IESB_Payload_Structure_v1) ───────────────
MAXIMO_API_KEY=
MAXIMO_BASE_URL=https://mmsiesb-dev.egat.co.th/maximo/api/os
MAXIMO_SITE_ID=IESB
MAXIMO_ORG_ID=EGAT
MAXIMO_COST_CENTER=N402040
MAXIMO_CRAFT=EVMAIN
CM_MAXIMO_ENABLED=true
PUBLIC_BASE_URL=

# ── ฟิลด์ที่ Maximo DEV ยังไม่รับ (ผลทดสอบ 2026-08-06) ──
# เปิดเป็น true เมื่อ EGAT ตั้งค่าฝั่ง Maximo เสร็จ
#   zcraft      : ค่าไม่อยู่ใน domain (ไม่มี WO ใบไหนในระบบใช้เลย)
#   failurecode : ต้องผูก failure class เข้ากับ location/asset ก่อน
MAXIMO_SEND_ZCRAFT=false
MAXIMO_SEND_WO_FAILURECODE=false
# reasonforchange ของ IN02 ยาวเกิน (BMXAA4049E) — 0 = ไม่ส่ง
MAXIMO_REASON_MAXLEN=0
# IN03 ต้องรอ EGAT เพิ่ม "WEB" เข้า domain URLTYPE (ตอนนี้มีแต่ FILE)
MAXIMO_URLTYPE=WEB
# laborcode ที่ยืนยันแล้วว่ามีเรคคอร์ด LABOR จริง — ใช้เดา mapping ให้ user ที่ยัง
# ไม่ได้ตั้ง users.maximo_laborcode (PERSON กับ LABOR เป็นคนละ object)
MAXIMO_LABOR_CODES=

# ─── Agentic AI — วินิจฉัยโมดูล M1–M7 ด้วย LLM on-prem (/ai/agent/*) ───
# LLM เป็น OpenAI-compatible endpoint ภายในองค์กร (Ollama / vLLM / LM Studio)
# ข้อมูล telemetry ไม่ออกนอกเครือข่าย EGAT
AGENT_ENABLED=true
# base URL ต้องลงท้าย /v1 — Ollama: http://<host>:11434/v1 , vLLM: http://<host>:8000/v1
AGENT_LLM_BASE_URL=http://localhost:11434/v1
# โมเดลที่รองรับ tool calling เช่น qwen2.5:7b-instruct, llama3.1:8b-instruct
AGENT_LLM_MODEL=qwen2.5:7b-instruct
# local server ส่วนใหญ่ไม่ตรวจ key แต่ต้องมีค่าไว้ (Ollama ใช้ค่าอะไรก็ได้)
AGENT_LLM_API_KEY=ollama
AGENT_LLM_TIMEOUT=60
# จำนวนรอบสูงสุดที่ agent เรียก tool ก่อนบังคับสรุป
AGENT_MAX_STEPS=6
AGENT_TEMPERATURE=0.2
# นาทีที่ cache ผลวินิจฉัยก่อนรันใหม่ (ตั้ง 0 = รันใหม่ทุกครั้ง)
AGENT_CACHE_MINUTES=30
